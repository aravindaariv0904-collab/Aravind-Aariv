# ==============================================================================
# Portfolio Contact Form SMTP Configuration Example
# ==============================================================================
# For local testing and Netlify production configuration.
# DO NOT commit real passwords, App Passwords, or API keys to version control.
# In Netlify production: Configure these in Site Configuration > Environment variables.
# ==============================================================================

# SMTP Service Host (e.g. smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL/TLS, 587 for STARTTLS)
SMTP_PORT=465

# Explicit SSL/TLS indicator (true for port 465, false for port 587)
SMTP_SECURE=true

# Authenticated SMTP User (Your Gmail address)
SMTP_USER=your-email@gmail.com

# Authenticated SMTP Password or Gmail 16-character App Password
# Generate via: Google Account > Security > 2-Step Verification > App passwords
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Target recipient for visitor contact inquiries
CONTACT_TO_EMAIL=aariv948@gmail.com

# Formatted Sender display in notification emails
CONTACT_FROM_EMAIL="Vejandla Aravind Aariv Portfolio" <your-email@gmail.com>
